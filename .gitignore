#ignore files by extension
*.fastq
*.fq 
*.fasta
*.gz
*.bam
*.bed
*.gtf
*.gff
*.h5
*.csv
*.tsv
*.rds
*.pdf
*.png
*.html
*.cloupe
*.xlsx
*.txt
# Exclude temporary and environment files 
logs/
tmp/
.slurm*
*.out
*.err
.env
.venv/
.envrc
.Rproj.user
.Rhistory*
.DS_Store
.RData
*.Rproj

#exlude renv files
# Ignore all project-local renv files
renv/*

# Keep renv bootstrap/configuration under version control
!renv/activate.R
!renv/settings.json

#exclude obsidian-specific files
*.obsidian/

