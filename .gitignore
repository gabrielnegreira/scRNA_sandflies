#ignore files by extension
*.fastq
*.fq 
*.fasta
*.gz
*.bam
*.bed
*.gtf
*.gff
*.h5
*.csv
*.tsv
*.rds
*.pdf
*.png
*.html
*.cloupe
*.xlsx
*.txt
# Ignore everything in inputs/ and outputs/
inputs/**
outputs/**
# But keep all .gitkeep files (any depth) so the directories themselves are shown in the repo
!inputs/**/*.gitkeep
!outputs/**/*.gitkeep
# Exclude temporary and environment files 
logs/
tmp/
.slurm*
*.out
*.err
.env
.venv/
.envrc
.Rproj.user
.Rhistory
.DS_Store
.RData
*.Rproj
